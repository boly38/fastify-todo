{
  "name": "fastify-todo",
  "version": "1.0.0",
  "description": "a VERY simple todoList PoC using fastify as backend, and vite+jsx+preact as front-end",
  "main": "index.js",
  "scripts": {
    "doc": "scripts 'build','start' are used as nixpacks cmd, cf. nixpacks.toml",
    "build": "pnpx vite build",
    "start": "node ./startServer.js",
    "test": "vitest run"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.3.3",
    "preact": "^10.26.9",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@vitejs/plugin-react": "^4.5.2",
    "supertest": "^7.1.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "engines": {
    "node": "v20"
  },
  "doc": {
    "nodejs-app-compliance": ["https://nixpacks.com/docs/providers/node"]
  },
  "pnpm": {
    "doc": "to fix ERR_REQUIRE_ESM by minimatch (glob@11 + minimatch@10 ESM/CJS issue)",
    "overrides": {
      "minimatch": "9.0.4"
    }
  }
}
